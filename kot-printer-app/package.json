{
  "name": "regalia-kot-printer-agent",
  "version": "1.1.1",
  "description": "Local tray agent that polls Ashoka Hotel for unprinted KOTs and sends them to a thermal printer (USB or Ethernet).",
  "main": "main.js",
  "author": "Ashoka Hotel",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "dist": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win --x64 --dir",
    "dist:installer": "electron-builder --win --x64"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "electron-store": "^8.2.0",
    "node-thermal-printer": "^4.4.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "in.regalia.kotagent",
    "productName": "Ashoka Hotel KOT Printer",
    "files": [
      "main.js",
      "preload.js",
      "config.js",
      "lib/**",
      "renderer/**",
      "assets/**"
    ],
    "asarUnpack": ["**/*.node", "**/@thiagoelg/**"],
    "win": {
      "target": ["nsis", "portable"],
      "sign": null,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
